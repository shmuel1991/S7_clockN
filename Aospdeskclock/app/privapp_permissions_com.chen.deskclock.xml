<!--
  Privileged-permission allowlist for the Desk Clock system app.

  Install this file to /system/etc/permissions (or
  /product/etc/permissions) so the platform grants the privileged
  permissions requested by the app when it is installed as a
  /system/priv-app system application. Without this allowlist the device
  will not boot when the app declares a privileged permission.
  -->
<permissions>
    <privapp-permissions package="com.chen.deskclock">
        <permission name="org.codeaurora.permission.POWER_OFF_ALARM" />
    </privapp-permissions>
</permissions>
