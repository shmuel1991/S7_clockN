<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 switch thumb tint: on-primary when checked, outline when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/md_on_primary" android:state_checked="true" />
    <item android:color="@color/md_outline" />
</selector>
