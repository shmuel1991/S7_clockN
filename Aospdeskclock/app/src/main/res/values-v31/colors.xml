<!-- Light-theme Material You dynamic color on Android 12+ (API 31). These map the app's
     md_* / content tokens to the wallpaper-derived @android:color/system_* palette so every
     static reference becomes dynamic automatically. -->
<resources>
    <color name="md_accent">@android:color/system_accent1_600</color>
    <color name="md_primary">@android:color/system_accent1_600</color>
    <color name="md_primary_dark">@android:color/system_accent1_700</color>
    <color name="md_background">@android:color/system_neutral1_10</color>
    <color name="md_surface">@android:color/system_neutral1_50</color>
    <color name="md_on_surface">@android:color/system_neutral1_900</color>
    <color name="md_focus_stroke">@android:color/system_accent1_600</color>

    <color name="md_on_primary">@android:color/system_accent1_0</color>
    <color name="md_outline">@android:color/system_neutral2_500</color>
    <color name="md_surface_variant">@android:color/system_neutral2_100</color>

    <color name="text_primary">@android:color/system_neutral1_900</color>
    <color name="text_secondary">@android:color/system_neutral2_700</color>
    <color name="icon_tint">@android:color/system_neutral1_900</color>
</resources>
