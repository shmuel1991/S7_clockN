<!-- Rounded-corner Material 3 focus/selection highlight. Uses the dynamic-aware
     md_focus_* palette (wallpaper-based on Android 12+ via runtime tinting,
     baseline Material 3 otherwise). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/focus_corner_radius" />
            <solid android:color="@color/md_focus_highlight" />
            <stroke
                android:width="2dp"
                android:color="@color/md_focus_stroke" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/focus_corner_radius" />
            <solid android:color="@color/md_focus_highlight" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/focus_corner_radius" />
            <solid android:color="@color/md_focus_highlight" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/focus_corner_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
